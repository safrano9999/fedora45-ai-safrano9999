#default-preset: insert later
#secret
CLOUDFLARE_API_TOKEN=

#repeat-group: OPENCLAW_TELEGRAM suffix02 OPENCLAW_TELEGRAM_AGENT OPENCLAW_TELEGRAMTOKEN OPENCLAW_TELEGRAM_CHAT_ID OPENCLAW_TELEGRAM_DEFAULT OPENCLAW_TELEGRAM_HEARTBEAT_MINUTES
#repeat-optional-complete: OPENCLAW_TELEGRAM_HEARTBEAT_MINUTES
#repeat-unique: OPENCLAW_TELEGRAM_AGENT
#repeat-freeform: OPENCLAW_TELEGRAM_AGENT
#default-preset: main
#required:
OPENCLAW_TELEGRAM_AGENT=main

#required:
#secret
OPENCLAW_TELEGRAMTOKEN=

#discover-telegram-chat: OPENCLAW_TELEGRAMTOKEN
#required:
OPENCLAW_TELEGRAM_CHAT_ID=

#repeat-one-true: OPENCLAW_TELEGRAM_DEFAULT
#choices: 0 1
#default-preset: 1
OPENCLAW_TELEGRAM_DEFAULT=1

# Heartbeat interval in minutes for this agent; 0 disables scheduled heartbeats.
#default-preset: 0
OPENCLAW_TELEGRAM_HEARTBEAT_MINUTES=0

#default-preset: 1
#required: automatically apply shared database values to explicitly opted-in services
DB_AUTO=1

#blank-if: DB_AUTO=0 DB_BACKEND DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD
#blank-if: DB_BACKEND=sqlite DB_HOST DB_PORT DB_USER DB_PASSWORD
#blank-if: DB_BACKEND=on_the_fly DB_HOST DB_PORT DB_USER DB_PASSWORD
#choices: postgres mysql mariadb sqlite on_the_fly
#default-preset: postgres
#required: shared database backend when DB_AUTO=1
DB_BACKEND=postgres

#default-preset: host.containers.internal
#required: shared database host when DB_AUTO=1
DB_HOST=host.containers.internal

#default-if: DB_BACKEND=mysql 3306
#default-if: DB_BACKEND=mariadb 3306
#default-if: DB_BACKEND=postgres 5432
#default-preset: 5432
#required: shared database port when DB_AUTO=1
DB_PORT=5432

#required: shared database name when DB_AUTO=1
DB_NAME=

#required: shared database user when DB_AUTO=1
DB_USER=

#required: shared database password when DB_AUTO=1
#secret
DB_PASSWORD=

# config.sh: autodetect GUI env, headless, or enter values manually
DISPLAY=:0

NO_AT_BRIDGE=1

XDG_RUNTIME_DIR=/tmp/runtime-root

#default-preset: insert later
#secret
TS_AUTHKEY=

#required:
OPENCLAW_START=1

#required:
HERMES_START=1

#required:
#secret
OPENCLAW_GATEWAY_TOKEN=example: openssl rand -hex 32

#repeat-group: OPENAI_V1 suffix OPENAI_V1_PROVIDER OPENAI_V1_URL OPENAI_V1_PORT OPENAI_V1_KEY OPENAI_V1_API_KEY_ALIAS OPENAI_V1_STREAM
#required:
OPENAI_V1_PROVIDER=litellm

#required:
OPENAI_V1_URL=http://169.254.1.2

#default-preset: 4000
#required:
OPENAI_V1_PORT=4000

#required:
#secret
OPENAI_V1_KEY=

#reverse-varname: OPENAI_V1_KEY
#required:
OPENAI_V1_API_KEY_ALIAS=

#default-preset: true
OPENAI_V1_STREAM=true

#default-preset: luna
#required:
OPENCLAW_OPENAI_V1_DEFAULT_LLM=luna

#default-preset: luna
#required:
HERMES_MODEL=luna

#valuedupe: HERMES_DASHBOARD_BASIC_AUTH_PASSWORD
#required:
#secret
HERMES_API_SERVER_KEY=example: openssl rand -hex 32

#default-preset: hermes
#required:
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes

#required:
#secret
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=example: openssl rand -hex 32

#secret
GH_TOKEN=

#required:
#secret
HERMES_TELEGRAMTOKEN=Hermes-Agent

#secret
BRAVE_API_KEY=

#secret
CLAUDE_CODE_OAUTH_TOKEN=

#repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
#repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
MCP_SERVER_NAME=

MCP_SERVER_URL=

#secret
MCP_SERVER_BEARER=

#choices: 0 1
#default-preset: 0
MCP_SERVER_ALLOW_PRIVATE=0

#choices: file sqlite mariadb postgres
#default-preset: file
#named-volume: /named_volumes/NOTE_SQLITE /named_volumes/NOTE_SQLITE /root/.openclaw/extensions/note/sqlite dir
NOTE_DB_BACKEND=file

#blank-if: NOTE_DB_BACKEND=file NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
#blank-if: NOTE_DB_BACKEND=sqlite NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
NOTE_DB_URL=127.0.0.1

NOTE_DB_PORT=5432

NOTE_DB_NAME=note

NOTE_DB_USER=note

#secret
NOTE_DB_PW=

#default-preset: note
NOTE_DB_PREFIX=note

#default-preset: insert later
#secret
TUNNEL_TOKEN=

# Optional dedicated token for the native OpenClaw agent hooks.
# Leave blank to keep the native hook endpoints disabled.
#secret
OPENCLAW_HOOKS_TOKEN=example: openssl rand -hex 32

# Optional memory embeddings. The first URL-enabled group is the global default.
#repeat-group: OPENCLAW_EMBEDDING suffix OPENCLAW_EMBEDDING_NAME OPENCLAW_EMBEDDING_URL OPENCLAW_EMBEDDING_MODEL OPENCLAW_EMBEDDING_BEARER
#repeat-optional-complete: OPENCLAW_EMBEDDING_BEARER
#repeat-unique: OPENCLAW_EMBEDDING_NAME
OPENCLAW_EMBEDDING_NAME=

OPENCLAW_EMBEDDING_URL=

OPENCLAW_EMBEDDING_MODEL=

# Optional token without the Bearer prefix; blank means no authentication.
#secret
OPENCLAW_EMBEDDING_BEARER=

# Codex agent ids for this MCP server (CSV). Blank or * means all agents.
#repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
#repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
#default-preset: *
MCP_ALLOW=*

# Optional HTTP webhooks, in group order. Repeated groups use _02, _03, etc.
#repeat-group: WEBHOOK suffix02 WEBHOOK_URL WEBHOOK_BEARER WEBHOOK_TIMES WEBHOOK_INIT
#repeat-optional-complete: WEBHOOK_BEARER WEBHOOK_TIMES WEBHOOK_INIT
WEBHOOK_URL=

#secret
WEBHOOK_BEARER=

# CSV wall-clock times in Europe/Vienna; blank means 00:00.
WEBHOOK_TIMES=

# Also call this webhook once after gateway startup, in group order.
#choices: false true
#default-preset: false
WEBHOOK_INIT=false

# Optional fast mode for the default model; applied by the mounted Hermes init hook.
#choices: off on
#default-preset: off
HERMES_MODEL_FAST_MODE=off

# Optional thinking level; applied by the mounted Hermes init hook.
#choices: off minimal low medium high xhigh max ultra
#default-preset: high
HERMES_MODEL_THINKING=high

# Token protecting Cloudflare edits in the WebUI.
#required:
#secret
CITADEL_TOKEN=example: openssl rand -hex 32

#default-preset: insert later
CLOUDFLARE_EMAIL=foo@bar.de

#repeat-group: NEXTCLOUD suffix02 NEXTCLOUD_URL NEXTCLOUD_USER NEXTCLOUD_PW NEXTCLOUD_SYNC_FOLDERS NEXTCLOUD_TIMER NEXTCLOUD_CALENDAR
#required: Nextcloud base URL
NEXTCLOUD_URL=

#required: Nextcloud username
NEXTCLOUD_USER=

#required: Nextcloud app password
#secret
NEXTCLOUD_PW=

#repeat-optional-complete: NEXTCLOUD_SYNC_FOLDERS
#default-preset: /named_volumes/NEXTCLOUD${REPEAT_SUFFIX}|/
#optional: CSV entries in LOCAL_PATH|REMOTE_PATH format; blank disables file sync
NEXTCLOUD_SYNC_FOLDERS=/named_volumes/NEXTCLOUD${REPEAT_SUFFIX}|/

#required: systemd sync interval; 0 disables automatic sync
#default-preset: 15m
NEXTCLOUD_TIMER=15m

#required: enable CalDAV calendar synchronization for this account
#default-preset: 1
NEXTCLOUD_CALENDAR=1

