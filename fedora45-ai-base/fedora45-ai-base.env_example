#default-preset: insert later
#secret
CLOUDFLARE_API_TOKEN=

#default-preset: 1
#required: automatically apply shared database values to explicitly opted-in services
DB_AUTO=1

#blank-if: DB_AUTO=0 DB_BACKEND DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD
#blank-if: DB_BACKEND=sqlite DB_HOST DB_PORT DB_USER DB_PASSWORD
#blank-if: DB_BACKEND=on_the_fly DB_HOST DB_PORT DB_USER DB_PASSWORD
#choices: postgres mysql mariadb sqlite on_the_fly
#default-preset: postgres
#required: shared database backend when DB_AUTO=1
DB_BACKEND=postgres

#default-preset: host.containers.internal
#required: shared database host when DB_AUTO=1
DB_HOST=host.containers.internal

#default-if: DB_BACKEND=mysql 3306
#default-if: DB_BACKEND=mariadb 3306
#default-if: DB_BACKEND=postgres 5432
#default-preset: 5432
#required: shared database port when DB_AUTO=1
DB_PORT=5432

#required: shared database name when DB_AUTO=1
DB_NAME=

#required: shared database user when DB_AUTO=1
DB_USER=

#required: shared database password when DB_AUTO=1
#secret
DB_PASSWORD=

# config.sh: autodetect GUI env, headless, or enter values manually
DISPLAY=:0

NO_AT_BRIDGE=1

XDG_RUNTIME_DIR=/tmp/runtime-root

#default-preset: insert later
#secret
TS_AUTHKEY=

#repeat-group: OPENAI_V1 suffix OPENAI_V1_PROVIDER OPENAI_V1_URL OPENAI_V1_PORT OPENAI_V1_KEY OPENAI_V1_API_KEY_ALIAS OPENAI_V1_STREAM
#required:
OPENAI_V1_PROVIDER=litellm

#required:
OPENAI_V1_URL=http://169.254.1.2

#default-preset: 4000
#required:
OPENAI_V1_PORT=4000

#required:
#secret
OPENAI_V1_KEY=example: openssl rand -hex 32

#reverse-varname: OPENAI_V1_KEY
#required:
OPENAI_V1_API_KEY_ALIAS=

#default-preset: true
OPENAI_V1_STREAM=true

#secret
GH_TOKEN=

#secret
BRAVE_API_KEY=

#secret
CLAUDE_CODE_OAUTH_TOKEN=

#repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
#repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
MCP_SERVER_NAME=

MCP_SERVER_URL=

#secret
MCP_SERVER_BEARER=

#choices: 0 1
#default-preset: 0
MCP_SERVER_ALLOW_PRIVATE=0

#choices: file sqlite mariadb postgres
#default-preset: file
#named-volume: /named_volumes/NOTE_SQLITE /named_volumes/NOTE_SQLITE /root/.openclaw/extensions/note/sqlite dir
NOTE_DB_BACKEND=file

#blank-if: NOTE_DB_BACKEND=file NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
#blank-if: NOTE_DB_BACKEND=sqlite NOTE_DB_URL NOTE_DB_PORT NOTE_DB_NAME NOTE_DB_USER NOTE_DB_PW NOTE_DB_PREFIX
NOTE_DB_URL=127.0.0.1

NOTE_DB_PORT=5432

NOTE_DB_NAME=note

NOTE_DB_USER=note

#secret
NOTE_DB_PW=

#default-preset: note
NOTE_DB_PREFIX=note

#secret
CLOUDFLARE_TUNNEL_TOKEN=

# Native OpenClaw providers are merged from openclaw-ephemeral.

# Voice settings are supplied by openclaw-ephemeral.

#default-preset: speaches-ai/piper-de_DE-thorsten-high
SPEACHES_TTS_MODEL=speaches-ai/piper-de_DE-thorsten-high

# Token protecting Cloudflare edits in the WebUI.
#required:
#secret
CITADEL_TOKEN=example: openssl rand -hex 32

#default-preset: insert later
CLOUDFLARE_EMAIL=foo@bar.de

#repeat-group: NEXTCLOUD suffix02 NEXTCLOUD_URL NEXTCLOUD_USER NEXTCLOUD_PW NEXTCLOUD_SYNC_FOLDERS NEXTCLOUD_TIMER NEXTCLOUD_CALENDAR
#optional: Nextcloud base URL; blank disables this account
NEXTCLOUD_URL=

#optional: Nextcloud username
NEXTCLOUD_USER=

#optional: Nextcloud app password
#secret
NEXTCLOUD_PW=

#repeat-optional-complete: NEXTCLOUD_URL NEXTCLOUD_USER NEXTCLOUD_PW NEXTCLOUD_SYNC_FOLDERS NEXTCLOUD_TIMER NEXTCLOUD_CALENDAR
#default-preset: /named_volumes/NEXTCLOUD${REPEAT_SUFFIX}|/
#optional: CSV entries in LOCAL_PATH|REMOTE_PATH format; blank disables file sync
NEXTCLOUD_SYNC_FOLDERS=/named_volumes/NEXTCLOUD${REPEAT_SUFFIX}|/

#optional: systemd sync interval; 0 disables automatic sync
#default-preset: 15m
NEXTCLOUD_TIMER=15m

#optional: enable CalDAV calendar synchronization for this account
#default-preset: 1
NEXTCLOUD_CALENDAR=1
