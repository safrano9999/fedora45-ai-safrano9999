# syntax=docker/dockerfile:1
ARG AI_SAFRANO9999_IMAGE=ghcr.io/safrano9999/fedora45-ai-safrano9999:2026.9.17.20
FROM ${AI_SAFRANO9999_IMAGE} AS layer-sources
USER root
COPY build/ /tmp/fedora45-ai-safrano9999-full/build/
COPY build.conf fedora45-ai-safrano9999-full.*_example /tmp/fedora45-ai-safrano9999-full/
# Native Git ADD follows each repository's current default branch.
ADD --keep-git-dir=true https://github.com/safrano9999/VikAI.git /tmp/fedora45-ai-safrano9999-full/safrano9999/VikAI/
RUN --mount=type=secret,id=GH_TOKEN,env=GH_TOKEN,required=true \
    /tmp/fedora45-ai-safrano9999-full/build/assemble-runtime.sh \
 && find /tmp/fedora45-ai-safrano9999-full/safrano9999 -name .git -type d -prune -exec rm -rf {} +

FROM ${AI_SAFRANO9999_IMAGE} AS ai-safrano9999-full


LABEL org.opencontainers.image.source="https://github.com/safrano9999/fedora45-ai-safrano9999" \
      org.opencontainers.image.title="fedora45-ai-safrano9999-full" \
      org.opencontainers.image.description="Optional VikAI agents on Fedora AI Safrano." \
      io.safrano9999.parent="fedora45-ai-safrano9999"

USER root

COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/requirements.safrano9999-full.txt /requirements.safrano9999-full.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /requirements.safrano9999-full.txt \
 && check-python-dependencies

COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/.safrano9999-full-source-tags.tsv /README/safrano9999-full-source-tags.tsv
COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/.fedora45-ai-repositories.list /usr/local/share/fedora45-ai/safrano9999-full-repositories.list
COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/.fedora45-image-runtime/manifest.tsv /usr/local/share/fedora45-ai/safrano9999-full-runtime-files.tsv
COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/.fedora45-image-runtime/systemd-enable.list /usr/local/share/fedora45-ai/safrano9999-full-systemd-enable.list
COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/.fedora45-image-runtime/rootfs/ /

COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/safrano9999/ /opt/safrano9999/

COPY --from=layer-sources /tmp/fedora45-ai-safrano9999-full/.fedora45-image-buildtime/ /tmp/fedora45-image-buildtime/
COPY build/run-container-buildtime.sh /tmp/fedora45-image-buildtime/run-container-buildtime
RUN --network=none \
    /tmp/fedora45-image-buildtime/run-container-buildtime \
      /tmp/fedora45-image-buildtime \
      fedora45-ai-safrano9999-full \
      /opt/safrano9999 \
 && rm -rf /tmp/fedora45-image-buildtime \
 && rm -rf /opt/safrano9999/*/image/runtime

RUN /usr/local/bin/openclaw-ephemeral.py configure \
 && find /root/.openclaw -maxdepth 1 -name 'openclaw.json*' -delete

RUN while IFS= read -r unit || [ -n "$unit" ]; do \
      [ -n "$unit" ] || continue; \
      systemctl enable "$unit"; \
    done < /usr/local/share/fedora45-ai/safrano9999-full-systemd-enable.list

USER root
WORKDIR /root
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
