BIP39_PUBLISH_PORT=11030

# Citadel owns the shared runtime layout from Base upwards.
#default-preset: ${CONTAINER_NAME}-tailscale:/opt/safrano9999/CITADEL/CITADEL_TAILSCALE:Z
TAILSCALE_VOLUMES=${CONTAINER_NAME}-tailscale:/opt/safrano9999/CITADEL/CITADEL_TAILSCALE:Z

# Container port block: 2=20000-29999, TUN=no host publishing, blank=manual.
#default-preset: TUN
CONTAINER_NR=TUN

OPENCLAW_GATEWAY_PUBLISH_PORT=18789

HERMES_DASHBOARD_PUBLISH_PORT=19119

HERMES_API_SERVER_PUBLISH_PORT=18642

OPENCODE_PUBLISH_PORT=4096

#default-preset: 11100
#required:
VDITOR_NOTES_PUBLISH_PORT=11100

#default-preset: 9090
#required:
COCKPIT_PUBLISH_PORT=9090

FEDORA45_AI_CAPABILITIES=NET_ADMIN,NET_RAW

FEDORA45_AI_DEVICES=/dev/net/tun

#repeat-group: ADDITIONAL_LINE suffix02 ADDITIONAL_LINE
#repeat-freeform: ADDITIONAL_LINE
#choices: Network=slirp4netns:mtu=1500 Network=pasta:--map-host-loopback,169.254.1.2,--dns-host,1.1.1.1,--dns-host,9.9.9.9
#default-preset: Network=pasta:--map-host-loopback,169.254.1.2,--dns-host,1.1.1.1,--dns-host,9.9.9.9
#discover-podman-host-internal
ADDITIONAL_LINE=Network=pasta:--map-host-loopback,169.254.1.2,--dns-host,1.1.1.1,--dns-host,9.9.9.9

HERMES_WEBHOOK_PUBLISH_PORT=18644

#required: CODEANALYST published host port
CODEANALYST_PUBLISH_PORT=11010

# Keep the image bootstrap: Tailscale, optional reset, Cloudflared, WebUI, scan.
#container-command: image

# Built only by GitHub Actions; latest tracks the newest successful image.
# Pull exclusively through Smart1.
IMAGE=ghcr.io/safrano9999/citadel:latest

# Volume naming; the Quadlet name comes from the checkout directory.
#default-preset: citadel
CONTAINER_NAME=citadel

#default-preset: 127.0.0.1
CITADEL_WEBUI_PUBLISH_HOST=127.0.0.1

# Blank for Podman-network-only access or Network=host.
#default-preset: 11000
CITADEL_WEBUI_PUBLISH_PORT=11000

# One shared bind: policy, scan/provider state, logos, Caddy config/output/socket.
# Application code stays in the image. Tailscale state remains separate.
#volume-if: CITADEL_VOLUMES CITADEL_VOLUMES
#default-preset: ./CITADEL_DATA:/opt/safrano9999/CITADEL/CITADEL_DATA:z
CITADEL_VOLUMES=./CITADEL_DATA:/opt/safrano9999/CITADEL/CITADEL_DATA:z

# May be blank for a mounted host Tailscale socket or TS_USERSPACE=1.
CITADEL_CAPABILITIES=NET_ADMIN,NET_RAW

CITADEL_DEVICES=/dev/net/tun

#required: KACHELMANN published WebUI port
KACHELMANN_PUBLISH_PORT=11040

#default-preset: 11041
# Host mapping only; KACHELMANN_MCP_ENABLED controls whether HTTP MCP starts.
KACHELMANN_MCP_PUBLISH_PORT=11041

