ARG AI_BASE_IMAGE
FROM ${AI_BASE_IMAGE} AS ai-kachelmann

ARG KACHELMANN_SOURCE_KEY

LABEL org.opencontainers.image.source="https://github.com/safrano9999/fedora45-ai-safrano9999" \
      org.opencontainers.image.title="fedora45-ai-kachelmann" \
      org.opencontainers.image.description="Fedora 45 AI Base with the KACHELMANN contribution." \
      io.safrano9999.parent="fedora45-ai-base" \
      io.safrano9999.kachelmann-source-tags.sha256="${KACHELMANN_SOURCE_KEY}"

USER root

COPY requirements.kachelmann.txt /requirements.kachelmann.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    sed -i 's/psycopg\[binary\]/psycopg/g' /requirements.kachelmann.txt \
 && pip install -r /requirements.kachelmann.txt \
 && pip check

ENV KACHELMANN_DIR=/opt/safrano9999/KACHELMANN \
    KACHELMANN_PYTHON=/usr/bin/python3

COPY .kachelmann-source-tags.tsv /README/kachelmann-source-tags.tsv
COPY .fedora45-ai-repositories.list /usr/local/share/fedora45-ai/kachelmann-repositories.list
COPY .fedora45-image-runtime/manifest.tsv /usr/local/share/fedora45-ai/kachelmann-runtime-files.tsv
COPY .fedora45-image-runtime/systemd-enable.list /usr/local/share/fedora45-ai/kachelmann-systemd-enable.list
COPY .fedora45-image-runtime/rootfs/ /

COPY safrano9999/ /opt/safrano9999/
RUN sed -i 's/psycopg\[binary\]/psycopg/g' /opt/safrano9999/KACHELMANN/requirements.txt

RUN uv pip install \
      --python /usr/local/lib/hermes-agent/venv/bin/python \
      --no-cache \
      "SQLAlchemy>=2.0" \
 && /usr/local/lib/hermes-agent/venv/bin/python -c 'import sqlalchemy'

COPY .fedora45-image-buildtime/ /tmp/fedora45-image-buildtime/
COPY build/run-container-buildtime.sh /tmp/fedora45-image-buildtime/run-container-buildtime
RUN --network=none \
    /tmp/fedora45-image-buildtime/run-container-buildtime \
      /tmp/fedora45-image-buildtime \
      fedora45-ai-kachelmann \
      /opt/safrano9999 \
 && rm -rf /tmp/fedora45-image-buildtime \
 && rm -rf /opt/safrano9999/*/image/runtime

RUN /usr/local/bin/openclaw-ephemeral.py configure \
 && find /root/.openclaw -maxdepth 1 -name 'openclaw.json*' -delete

RUN while IFS= read -r unit || [ -n "$unit" ]; do \
      [ -n "$unit" ] || continue; \
      systemctl enable "$unit"; \
    done < /usr/local/share/fedora45-ai/kachelmann-systemd-enable.list

USER root
WORKDIR /root
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
