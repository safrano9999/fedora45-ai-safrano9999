# syntax=docker/dockerfile:1
ARG AI_BASE_IMAGE
FROM ${AI_BASE_IMAGE} AS layer-sources
USER root
COPY build/ /tmp/fedora45-ai-kachelmann/build/
COPY build.conf fedora45-ai-kachelmann.*_example /tmp/fedora45-ai-kachelmann/
# Native Git ADD follows each repository's current default branch.
ADD --keep-git-dir=true https://github.com/safrano9999/KACHELMANN.git /tmp/fedora45-ai-kachelmann/safrano9999/KACHELMANN/
# Install the KACHELMANN agent integration for OpenClaw only.
# Exclude Hermes before assembly so the runtime manifest stays accurate.
RUN rm -rf /tmp/fedora45-ai-kachelmann/safrano9999/KACHELMANN/hermes \
 && rm -f /tmp/fedora45-ai-kachelmann/safrano9999/KACHELMANN/image/runtime/etc/systemd/system/hermes.service.d/30-kachelmann.conf \
          /tmp/fedora45-ai-kachelmann/safrano9999/KACHELMANN/image/runtime/usr/local/bin/kachelmann-hermes-enable
RUN --mount=type=secret,id=GH_TOKEN,env=GH_TOKEN,required=true \
    /tmp/fedora45-ai-kachelmann/build/assemble-runtime.sh \
 && find /tmp/fedora45-ai-kachelmann/safrano9999 -name .git -type d -prune -exec rm -rf {} +

FROM ${AI_BASE_IMAGE} AS ai-kachelmann


LABEL org.opencontainers.image.source="https://github.com/safrano9999/fedora45-ai-safrano9999" \
      org.opencontainers.image.title="fedora45-ai-kachelmann" \
      org.opencontainers.image.description="Fedora 45 AI Base with the KACHELMANN contribution." \
      io.safrano9999.parent="fedora45-ai-base"

USER root

COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/requirements.kachelmann.txt /requirements.kachelmann.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    sed -i 's/psycopg\[binary\]/psycopg/g' /requirements.kachelmann.txt \
 && pip install -r /requirements.kachelmann.txt \
 && pip check

ENV KACHELMANN_DIR=/opt/safrano9999/KACHELMANN \
    KACHELMANN_PYTHON=/usr/bin/python3

COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/.kachelmann-source-tags.tsv /README/kachelmann-source-tags.tsv
COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/.fedora45-ai-repositories.list /usr/local/share/fedora45-ai/kachelmann-repositories.list
COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/.fedora45-image-runtime/manifest.tsv /usr/local/share/fedora45-ai/kachelmann-runtime-files.tsv
COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/.fedora45-image-runtime/systemd-enable.list /usr/local/share/fedora45-ai/kachelmann-systemd-enable.list
COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/.fedora45-image-runtime/rootfs/ /

COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/safrano9999/ /opt/safrano9999/
COPY safrano9999/KACHELMANN/*.apk /opt/safrano9999/KACHELMANN/
RUN sed -i 's/psycopg\[binary\]/psycopg/g' /opt/safrano9999/KACHELMANN/requirements.txt

COPY --from=layer-sources /tmp/fedora45-ai-kachelmann/.fedora45-image-buildtime/ /tmp/fedora45-image-buildtime/
COPY build/run-container-buildtime.sh /tmp/fedora45-image-buildtime/run-container-buildtime
RUN --network=none \
    /tmp/fedora45-image-buildtime/run-container-buildtime \
      /tmp/fedora45-image-buildtime \
      fedora45-ai-kachelmann \
      /opt/safrano9999 \
 && rm -rf /tmp/fedora45-image-buildtime \
 && rm -rf /opt/safrano9999/*/image/runtime

RUN /usr/local/bin/openclaw-ephemeral.py configure \
 && find /root/.openclaw -maxdepth 1 -name 'openclaw.json*' -delete

RUN while IFS= read -r unit || [ -n "$unit" ]; do \
      [ -n "$unit" ] || continue; \
      systemctl enable "$unit"; \
    done < /usr/local/share/fedora45-ai/kachelmann-systemd-enable.list

USER root
WORKDIR /root
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
