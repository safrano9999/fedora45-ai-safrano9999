#!/usr/bin/env python3
"""Append optional webhook calls to existing repository routines."""
import json
import os
import re
from pathlib import Path
import subprocess

runtime = Path('/run/safrano9999-webhooks.env')
if runtime.exists():
    for line in runtime.read_text().splitlines():
        key, value = line.split('=', 1)
        os.environ.setdefault(key, value)
if any(value for key, value in os.environ.items() if re.fullmatch(r'WEBHOOK_URL(?:[0-9]{2,})?', key)):
    result = subprocess.run(['openclaw', 'cron', 'list', '--all', '--json'],
                            capture_output=True, text=True, check=True, timeout=90)
    decoder = json.JSONDecoder()
    for offset, character in enumerate(result.stdout):
        if character != '{':
            continue
        try:
            data, _ = decoder.raw_decode(result.stdout[offset:])
        except ValueError:
            continue
        if isinstance(data, dict) and isinstance(data.get('jobs'), list):
            break
    else:
        raise RuntimeError('Missing cron inventory')
    for job in data['jobs']:
        argv = job.get('payload', {}).get('argv', [])
        if not job.get('name', '').startswith('openclaw-ephemeral-repositories-'):
            continue
        if argv[:2] != ['/usr/local/bin/openclaw-ephemeral.py', 'dispatch']:
            continue
        subprocess.run(['openclaw', 'cron', 'edit', job['id'], '--command-argv',
                        json.dumps(['/usr/local/bin/safrano9999-fullrun', *argv])],
                       capture_output=True, check=True, timeout=90)
        print('Optional webhooks attached:', job['name'])
