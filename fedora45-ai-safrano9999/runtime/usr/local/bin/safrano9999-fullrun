#!/usr/bin/env python3
"""Run the existing repository routine, inserting generic webhooks after WELCOME."""
import io
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import urlsplit
from urllib.request import urlopen

from openclaw_ephemeral.cli import main
from openclaw_ephemeral.environment import config_path
from openclaw_ephemeral.plugins import discover_openclaw_plugins


def run():
    runtime = Path('/run/safrano9999-webhooks.env')
    if runtime.exists():
        for line in runtime.read_text().splitlines():
            key, value = line.split('=', 1)
            os.environ.setdefault(key, value)
    args = sys.argv[1:]
    if args[:1] == ['/usr/local/bin/openclaw-ephemeral.py']:
        args = args[1:]
    if not args:
        args = ['dispatch', '--repos', os.environ.get('OPENCLAW_CRONTAB_REPOS', '')]
    enabled = any(value for key, value in os.environ.items()
                  if re.fullmatch(r'WEBHOOK_URL(?:[0-9]{2,})?', key))
    if not enabled:
        return main(args)
    plugins, _ = discover_openclaw_plugins(os.environ, destination=config_path(os.environ))
    welcome = next((p.hook_path for p in plugins if p.repository == 'WELCOME'), None)
    sent = False
    failed = 0

    def webhooks():
        nonlocal sent, failed
        if sent:
            return
        sent = True
        try:
            result = subprocess.run(['/usr/local/bin/safrano9999-webhooks'],
                                    capture_output=True, text=True, check=True)
            if result.stdout.strip():
                print(result.stdout, end='', flush=True)
                subprocess.run(['openclaw', 'message', 'send', '--channel', 'telegram',
                                '--target', os.environ['OPENCLAW_TELEGRAM_CHAT_ID'],
                                '--message', result.stdout.strip()],
                               capture_output=True, check=True, timeout=90)
        except (subprocess.SubprocessError, OSError, KeyError):
            print('Optional webhook request or Telegram delivery failed.', file=sys.stderr)
            failed = 1

    def open_hook(request, **kwargs):
        response = urlopen(request, **kwargs)
        if urlsplit(request.full_url).path == welcome:
            content = response.read()
            response.close()
            webhooks()
            return io.BytesIO(content)
        return response

    status = main(args, opener=open_hook)
    webhooks()  # Also handles configurations without a WELCOME init hook.
    return status or failed


if __name__ == '__main__':
    raise SystemExit(run())
