          "jsCode": "const url=$json.headers?.location;\nif($json.statusCode!==302 || typeof url!=='string' || !/^https:\\/\\/productionresults[a-z0-9]+\\.blob\\.core\\.windows\\.net\\//.test(url))throw new Error('Unexpected GitHub artifact download location');\nreturn [{json:{url}}];"
