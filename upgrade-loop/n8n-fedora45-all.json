        "parameters": {
          "jsCode": "const artifacts=($json.artifacts??[]).filter(a=>a.name==='container-preparation'&&!a.expired);\nif(artifacts.length!==1||artifacts[0].size_in_bytes>10000000)throw new Error('Missing or invalid preparation evidence');\nreturn [{json:{artifact_id:artifacts[0].id}}];"
