[Unit]
Description=Tailscale daemon
Requires=persistainer.service
After=network.target persistainer.service

[Service]
Type=notify
PassEnvironment=TS_AUTHKEY TS_STATE_DIR
Environment=TS_STATE_DIR=/var/lib/tailscale
ExecCondition=/bin/bash -c '[ -n "$$TS_AUTHKEY" ] || [ -s "$${TS_STATE_DIR:-/var/lib/tailscale}/tailscaled.state" ]'
ExecStart=/usr/sbin/tailscaled --statedir=${TS_STATE_DIR}
# Serve reset is owned by tailscale-up.service after authentication/readiness.
Restart=on-failure

[Install]
WantedBy=multi-user.target
