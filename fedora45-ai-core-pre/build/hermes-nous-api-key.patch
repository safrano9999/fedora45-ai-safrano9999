diff --git a/tests/hermes_cli/test_nous_api_key.py b/tests/hermes_cli/test_nous_api_key.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e1451ddd5fea4528e9e84436957f96f2e248153
--- /dev/null
+++ b/tests/hermes_cli/test_nous_api_key.py
@@ -0,0 +1,108 @@
+"""Direct Nous API keys share the real pool without entering OAuth flows."""
+
+from unittest.mock import Mock
+
+import pytest
+
+from agent import auxiliary_client as auxiliary
+from agent.credential_pool import AUTH_TYPE_API_KEY, CredentialPool, load_pool
+from hermes_cli import auth, nous_auth_keepalive, runtime_provider
+from hermes_cli.providers import get_provider
+
+
+@pytest.fixture
+def nous_key(monkeypatch):
+    key = "sk-nous-api-key-regression-test"
+    monkeypatch.setenv("NOUS_API_KEY", key)
+    return key
+
+
+@pytest.fixture
+def no_oauth_refresh(monkeypatch):
+    refresh = Mock(side_effect=AssertionError("API keys must not enter OAuth refresh"))
+    monkeypatch.setattr(CredentialPool, "try_refresh_current", refresh)
+    monkeypatch.setattr(auth, "resolve_nous_runtime_credentials", refresh)
+    monkeypatch.setattr(runtime_provider, "resolve_nous_runtime_credentials", refresh)
+    monkeypatch.setattr(nous_auth_keepalive, "resolve_nous_runtime_credentials", refresh)
+    return refresh
+
+
+def test_nous_api_key_is_discovered_without_changing_interactive_oauth(nous_key):
+    provider = get_provider("nous", allow_network=False)
+    assert provider.auth_type == auth.PROVIDER_REGISTRY["nous"].auth_type == "oauth_device_code"
+    assert "NOUS_API_KEY" in provider.api_key_env_vars
+    assert auth.is_provider_explicitly_configured("nous")
+    assert auth.resolve_provider("auto") == "nous"
+
+
+def test_nous_api_key_seeds_usable_pool_entry(nous_key):
+    entry = load_pool("nous").select()
+    assert entry is not None
+    assert entry.source == "env:NOUS_API_KEY"
+    assert entry.auth_type == AUTH_TYPE_API_KEY
+    assert entry.runtime_api_key == nous_key
+    assert entry.runtime_base_url == auth.DEFAULT_NOUS_INFERENCE_URL
+    assert not entry.refresh_token
+
+
+def test_nous_api_key_rotation_rehydrates_same_pool_entry(nous_key, monkeypatch):
+    before = load_pool("nous").select()
+    assert before is not None
+    rotated = nous_key + "-rotated"
+    monkeypatch.setenv("NOUS_API_KEY", rotated)
+    after = load_pool("nous").select()
+    assert after is not None
+    assert after.id == before.id
+    assert after.runtime_api_key == rotated
+
+
+def test_nous_api_key_respects_source_suppression(nous_key):
+    assert load_pool("nous").select() is not None
+    auth.suppress_credential_source("nous", "env:NOUS_API_KEY")
+    assert load_pool("nous").select() is None
+
+
+@pytest.mark.parametrize("requested", ["nous", "auto"])
+@pytest.mark.parametrize(
+    ("model", "wire", "api_mode"),
+    [
+        ("hermes-test-model", None, "chat_completions"),
+        ("anthropic/test-model", None, "chat_completions"),
+        ("hermes-test-model", "native", "chat_completions"),
+        ("anthropic/test-model", "native", "anthropic_messages"),
+    ],
+)
+def test_nous_api_key_resolves_main_runtime(nous_key, no_oauth_refresh, requested, model, wire, api_mode, tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    if wire:
+        (tmp_path / "config.yaml").write_text(f"nous:\n  anthropic_wire: {wire}\n")
+    runtime = runtime_provider.resolve_runtime_provider(requested=requested, target_model=model)
+    assert runtime["provider"] == "nous"
+    assert runtime["api_key"] == nous_key
+    assert runtime["base_url"] == auth.DEFAULT_NOUS_INFERENCE_URL
+    assert runtime["source"] == "env:NOUS_API_KEY"
+    assert runtime["credential_pool"].provider == "nous"
+    assert runtime["api_mode"] == api_mode
+    no_oauth_refresh.assert_not_called()
+
+
+@pytest.mark.parametrize("force_refresh", [False, True])
+def test_nous_api_key_resolves_auxiliary_runtime(nous_key, no_oauth_refresh, force_refresh):
+    assert auxiliary._resolve_nous_runtime_api(force_refresh=force_refresh) == (
+        nous_key,
+        auth.DEFAULT_NOUS_INFERENCE_URL,
+    )
+    no_oauth_refresh.assert_not_called()
+
+
+def test_nous_api_key_keepalive_does_not_refresh(nous_key, no_oauth_refresh):
+    assert nous_auth_keepalive.refresh_nous_auth_keepalive_once()
+    no_oauth_refresh.assert_not_called()
+
+
+def test_nous_api_key_runtime_keeps_canonical_url_override(nous_key, no_oauth_refresh, monkeypatch):
+    base_url = "https://inference.staging.example/v1"
+    monkeypatch.setenv("NOUS_INFERENCE_BASE_URL", base_url + "/")
+    assert runtime_provider.resolve_runtime_provider(requested="nous")["base_url"] == base_url
+    assert auxiliary._resolve_nous_runtime_api() == (nous_key, base_url)
+    no_oauth_refresh.assert_not_called()
