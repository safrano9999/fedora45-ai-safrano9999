#CONTAINER-NAME
#default-preset: fedora45-ai-core
#required:
CONTAINER_NAME=fedora45-ai-core

#default-preset: ${CONTAINER_NAME}
#required:
TS_HOSTNAME=${CONTAINER_NAME}

#default-preset: --ssh
TS_EXTRA_ARGS=--ssh

#mount-bind: FEDORA45_AI_INIT_HOOKS_PATH:/usr/local/share/fedora45-ai/init.d
#default-preset: %config-conf/fedora45-ai-init.d
FEDORA45_AI_INIT_HOOKS_PATH=%config-conf/fedora45-ai-init.d

#mount-bind-ro-shared: CA_CERTIFICATES_PATH:/usr/local/share/ca-certificates-extra
CA_CERTIFICATES_PATH=

#choices: 0 1
#default-preset: 0
CLOUDFLARED_START=0

#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/workspace /root/.openclaw/workspace dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/agents /root/.openclaw/agents dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/state /root/.openclaw/state dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/backups /root/.openclaw/backups dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/session-sqlite-migration-runs /root/.openclaw/session-sqlite-migration-runs dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/skills /root/.openclaw/skills dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/skill-workshop /root/.openclaw/skill-workshop dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/workspace-worker /root/.openclaw/workspace-worker dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/workspace-architect /root/.openclaw/workspace-architect dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/workspace-qc /root/.openclaw/workspace-qc dir
#named-volume: /named_volumes/OPENCLAW /named_volumes/OPENCLAW/workspace-attestations /root/.openclaw/workspace-attestations dir
#default-preset: 1
OPENCLAW_PERSISTENT=1

OPENCLAW_GATEWAY_PORT=18789

#default-preset: dummy/note
OPENCLAW_MODEL=dummy/note

#default-preset: 1
OPENCLAW_NOTE_FULL_MODE=1

#when: NOTE_DB_BACKEND=file
#required:
NOTE_PATH=./OBSIDIAN/NOTES/INBOX

#default-preset: 1
NOTE_FEEDBACK=1

#choices: none webhook cli
#default-preset: none
NOTE_TRIGGER_TYPE=none

#when-not: NOTE_TRIGGER_TYPE=none
#default-if: NOTE_TRIGGER_TYPE=webhook https://n8n.example.com/webhook/note
#default-if: NOTE_TRIGGER_TYPE=cli openclaw agent --agent notes --message "Message: $NOTE_MESSAGE Date: $NOTE_DATE Time: $NOTE_TIME Path: $NOTE_PATH Channel: $NOTE_CHANNEL Account: $NOTE_ACCOUNT_ID Sender: $NOTE_SENDER_ID Message-ID: $NOTE_MESSAGE_ID Prompt: $NOTE_PROMPT"
NOTE_TRIGGER=

#default-preset: prompt_default.md
NOTE_PROMPT=prompt_default.md

HERMES_DASHBOARD_PORT=9119

HERMES_API_SERVER_PORT=8642

#default-preset: /data
#required:
VDITOR_NOTES_PATH=/data

#default-preset: 11100
#required:
VDITOR_NOTES_PORT=11100
