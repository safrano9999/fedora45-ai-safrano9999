[Unit]
Description=Run configured Fedora45 AI initialization hooks
Requires=persistainer.service
Wants=openclaw-config.service hermes-config.service
After=persistainer.service openclaw-config.service hermes-config.service
Before=openclaw.service hermes.service
ConditionDirectoryNotEmpty=/usr/local/share/fedora45-ai/init.d

[Service]
Type=oneshot
Environment=FEDORA45_AI_INIT_HOOKS_DIR=/usr/local/share/fedora45-ai/init.d
ExecStart=/usr/local/bin/fedora45-ai-init-hooks
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
