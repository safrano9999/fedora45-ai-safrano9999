#!/usr/bin/env bash
set -euo pipefail

hook_dir="${FEDORA45_AI_INIT_HOOKS_DIR:-/usr/local/share/fedora45-ai/init.d}"

[[ "$hook_dir" == /* && "$hook_dir" != / ]] || {
    echo "Invalid FEDORA45_AI_INIT_HOOKS_DIR: $hook_dir" >&2
    exit 2
}
[ -d "$hook_dir" ] || exit 0

failed=0
while IFS= read -r -d '' hook; do
    echo "Running init hook: $hook"
    case "$hook" in
        *.sh) /bin/bash "$hook" || failed=1 ;;
        *.py) /usr/bin/python3 "$hook" || failed=1 ;;
    esac
done < <(find "$hook_dir" -mindepth 1 -type f \
    \( -name '*.sh' -o -name '*.py' \) -print0 \
  | LC_ALL=C sort -z)
exit "$failed"
